# Copy to .env and fill in. Never commit .env.

# development | staging (hosted, mock checkout allowed) | production (real payments only)
NODE_ENV=development
PORT=4000

# Comma-separated list of frontend origins allowed to call this API from a browser.
CORS_ORIGINS=http://localhost:5173,http://localhost:5174
# Number of reverse proxies in front of the API (0 locally; 1 on most hosts). Needed for correct per-IP rate limiting.
TRUST_PROXY=0

# --- Supabase (Project Settings > API, and the "Connect" button) --------------------------------------------
SUPABASE_URL=https://YOUR-PROJECT-REF.supabase.co
# Publishable key (sb_publishable_...) or the legacy "anon" key. Safe for browsers; the API uses it for sign-in/OTP calls.
SUPABASE_PUBLISHABLE_KEY=
# Secret key (sb_secret_...) or the legacy "service_role" key. SERVER ONLY. Bypasses all security rules.
SUPABASE_SECRET_KEY=

# Postgres connection string. Use the "Session pooler" string (port 5432) from Connect > Connection string;
# the direct "db.<ref>.supabase.co" host is IPv6-only and fails on many home networks.
DATABASE_URL=postgresql://postgres.YOUR-PROJECT-REF:YOUR-DB-PASSWORD@aws-0-REGION.pooler.supabase.com:5432/postgres
# Set to false only for a local, non-TLS Postgres.
DATABASE_SSL=true

# --- App secrets ---------------------------------------------------------------------------------------------
# Signs short-lived password-reset tokens. Generate: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
# Optional in development (a random one is generated per start); REQUIRED, 32+ chars, in production.
APP_SECRET=
# HMAC secret shared with the payment gateway for webhook verification. Same rules as above.
PAYMENT_WEBHOOK_SECRET=

# Enables the fake checkout endpoints (/api/wallet/fund/mock-*). Defaults to true in development, and the server
# refuses to start with it enabled in production.
ENABLE_MOCK_PAYMENTS=true

# Turns off rate limiting so scripts/e2e.ts can be re-run back to back. Never in production (the server refuses to start).
DISABLE_RATE_LIMITS=false
